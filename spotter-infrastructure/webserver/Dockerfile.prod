# ---------- Build frontend ----------
FROM node:26-alpine AS frontend-build

WORKDIR /app

RUN npm install -g corepack && corepack enable

COPY spotter-frontend/apps/web/package.json spotter-frontend/apps/web/yarn.lock ./
# Persist successful downloads across failed builds. Lock the shared cache
# while the frontend/runtime and gateway targets build in parallel.
RUN --mount=type=cache,id=spotter-yarn,target=/usr/local/share/.cache/yarn,sharing=locked \
    yarn install --frozen-lockfile --cache-folder /usr/local/share/.cache/yarn \
    --network-timeout 600000 --network-concurrency 2

COPY spotter-frontend/apps/web/ ./

# Only public Vite values belong here.
# Never pass API keys, database URLs, or server secrets.
ARG VITE_API_BASE_URL="/api"
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL

RUN yarn build


# ---------- TanStack Start runtime ----------
FROM node:26-alpine AS frontend-runtime
WORKDIR /app
ENV NODE_ENV=production HOST=0.0.0.0 PORT=3000
COPY --from=frontend-build --chown=node:node /app/.output ./.output
USER node
EXPOSE 3000
CMD ["node", ".output/server/index.mjs"]

# ---------- Nginx gateway ----------
FROM nginx:alpine AS gateway

RUN rm -f /etc/nginx/conf.d/default.conf

# Which server config to bake in — "prod" (webserver/conf.d/prod) by
# default, or "development" (webserver/conf.d/development) for the
# Development server environment. Same image, same frontend build; only
# the Nginx server_name/config differs.
ARG CONF_ENV=prod

COPY spotter-infrastructure/webserver/conf.d/${CONF_ENV} /etc/nginx/conf.d
COPY spotter-infrastructure/webserver/snippets /etc/nginx/snippets
COPY --from=frontend-build /app/.output/public /usr/share/nginx/html

EXPOSE 80
