# Copy to .env.development on the Development server before running:
#   docker compose -f docker-compose.development.yml --env-file .env.development up -d --build
#
# Fill in real values — this file only ships placeholders and is never
# used directly. Never commit the real .env.development.
#
# IMPORTANT: POSTGRES_PASSWORD below and the password embedded in
# DATABASE_URL must be the SAME value — Postgres is provisioned with
# POSTGRES_PASSWORD, and the backend authenticates against it using
# DATABASE_URL. If they don't match, the backend can't connect.
#
# Generate a real password with, e.g.: openssl rand -base64 32

POSTGRES_USER=spotter
POSTGRES_PASSWORD=REPLACE_WITH_GENERATED_PASSWORD
POSTGRES_DB=spotter

# Backend settings (passed via env_file: .env.development in
# docker-compose.development.yml). DATABASE_URL's password must match
# POSTGRES_PASSWORD above exactly.
DJANGO_SECRET_KEY=REPLACE_WITH_GENERATED_SECRET
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=dev.spotter.com
DATABASE_URL=postgresql://spotter:REPLACE_WITH_GENERATED_PASSWORD@postgres:5432/spotter
REDIS_URL=redis://redis:6379
CORS_ORIGIN=http://dev.spotter.com

# Passed as a build arg to the webserver image — the frontend calls the
# API same-origin through Nginx, so this stays /api unless the frontend
# is ever served from a different origin than the backend.
VITE_API_BASE_URL=/api

# Public hostname must also appear in DJANGO_ALLOWED_HOSTS.
PUBLIC_HOST=dev.spotter.com

# Nginx Proxy Manager owns host ports 80/443. Its proxy host forwards
# HTTP requests to this dedicated Spotter gateway port.
HTTP_PORT=8085
HTTP_BIND_ADDRESS=0.0.0.0
