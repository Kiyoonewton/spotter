# Copy to .env in this directory before running:
#   docker compose up -d
#
# Safe local-only placeholders — never commit a real .env here, and never
# use these values for staging or production.
#
# This only configures the shared Postgres container. Backend application
# runtime settings (DATABASE_URL overrides, CORS_ORIGIN, etc.) live in
# ../spotter-backend/.env — see that repo's README, not this file.

POSTGRES_USER=spotter
POSTGRES_PASSWORD=spotter
POSTGRES_DB=spotter
