# Copy this file to .env and fill in values for your environment.
# Never commit real secrets — this file must only ever contain placeholders.

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=*

# Database. Falls back to SQLite when unset. When running via Docker
# Compose, the host is the `postgres` service name, not localhost.
DATABASE_URL=postgresql://spotter:spotter@postgres:5432/spotter

# Matching credentials for the postgres service in spotter-infrastructure.
POSTGRES_USER=spotter
POSTGRES_PASSWORD=spotter
POSTGRES_DB=spotter

# Redis. Optional — nothing uses it yet. The host is the `redis` Compose
# service name, not localhost.
# REDIS_URL=redis://redis:6379

# Comma-separated list of allowed frontend origins.
CORS_ORIGIN=http://localhost:5173
